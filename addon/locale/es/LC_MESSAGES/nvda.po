#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on to be shown on installation and add-on information.
#: buildVars.py:21
msgid "ApprentiClavier: accessibility enhancement"
msgstr "ApprentiClavier: complementos de accesibilidad"

#: buildVars.py:25
msgid ""
"Provide voice assistance  to ApprentiClavier keyboard learner (only french "
"version).\n"
"Compatible and Tested with ApprentiClavier french version 1.0.9  and "
"1.0.10.\n"
msgstr ""
"Este complemento proporciona asistencia de voz para ApprentiClavier, "
"software de aprendizaje de teclado (solo la versión francesa).  \n"
"No se añade ningún script.\n"
"Compatible y probado con ApprentiClavier versión francesa 1.0.9 y 1.0.10.\n"

#. Translators: the label of a message box dialog.
#: installTasks.py:40
msgid "Do you want to keep current add-on configuration settings ?"
msgstr ""
"¿Deseas conservar las opciones de configuración del complemento actual?"

#. Translators: the title of a message box dialog.
#: installTasks.py:42 installTasks.py:47
#, python-format
msgid "%s - installation"
msgstr "%s - instalación"

#. Translators: the label of a message box dialog.
#: installTasks.py:45
msgid ""
"Are you sure you don't want to keep the current add-on configuration "
"settings?"
msgstr ""
"¿Estás seguro de que no deseas conservar las opciones de configuración del "
"complemento actual?"

#: shared\ac_addonConfigManager.py:127
msgid ""
"The configuration file of the add-on contains errors. The  configuration has "
"been reset to factory defaults"
msgstr ""
"El archivo de la configuración del complemento contiene errores. La "
"configuración se ha restablecido a los valores predeterminados"

#. Translators: title of message box
#: shared\ac_addonConfigManager.py:130
msgid "Warning"
msgstr "Advertencia"

#. Translators: message to user to report parsing error.
#: appModules\apprenticlavier\ac_config.py:151
#, python-format
msgid "Error parsing ApprentiClavier configuration file: %s"
msgstr ""
"Error de decodificación del archivo de configuración del complemento: %s"

#. Translators: This is the label for the ApprentiClaviery settings  dialog.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:26
#, python-format
msgid "%s - settings"
msgstr "%s - opciones"

#. Translators: This is the label for a group of editing options in the ApprentiClavier settings panel.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:31
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:98
msgid "Update"
msgstr "Actualización"

#. Translators: This is the label for a checkbox in the ApprentiClavier SettingsDialog.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:36
msgid "Automatically check for &updates"
msgstr "Buscar automáticamente &actualizaciones"

#. Translators: This is the label for a checkbox in the ApprentiClavier settings panel.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:40
msgid "Update also release versions to &developpement versions"
msgstr "Actualizar también versiones estable hacia versiones de &desarrollo"

#. translators: label for a button in ApprentiClavier settings panel.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:46
msgid "&Check for update"
msgstr "&Buscar actualización"

#. translators: this is a label for a button in update settings panel.
#: globalPlugins\apprentiClavierAccessEnhancement\ac_configGui.py:51
msgid "View &history"
msgstr "Ver &historial"

#. Translators: The progress message
#. indicating the name of the add-on being downloaded.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:101
msgid "Downloading {name}"
msgstr "Descargando {name}"

#. Translators: A message indicating that an error occurred
#. while downloading an update to NVDA.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:116
msgid "Error downloading update for {name}."
msgstr "Error al descargar la actualización de {name}."

#. Translators: message to user
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:170
msgid "Cannot update {name} - missing file or invalid file format"
msgstr ""
"No se puede actualizar {name} - archivo ausente o formato de archivo no "
"válido"

#. Translators: The title of the dialog
#. presented while an Addon is being updated.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:187
msgid "Updating"
msgstr "Actualizando"

#. Translators: The message displayed while an addon is being updated.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:189
msgid "Please wait while the add-on is being updated."
msgstr "Por favor, espera mientras se actualiza el complemento."

#. Translators: The message displayed when an error occurs
#. when installing an add-on package.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:211
msgid "Failed to update {name} add-on"
msgstr "Fallo al actualizar el complemento {name}"

#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:255
msgid "{summary} - update"
msgstr "{summary} - actualización"

#. Translators: message to user that the update service is temporarily in maintenance
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:268
msgid "The service is temporarily under maintenance. Please, try again later."
msgstr ""
"El servicio está actualmente en mantenimiento. Por favor, inténtelo de nuevo "
"más tarde."

#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:295
msgid ""
"The update is not compatible with this version of NVDA. Minimum NVDA "
"version: {minYear}.{minMajor}, last tested: {testedYear}.{testedMajor}."
msgstr ""
"La actualización no es compatible con esta versión de NVDA. Versión mínima "
"de NVDA: {minYear}.{minMajor}, última probada: {testedYear}.{testedMajor}."

#. Translators: message to user to report a new version.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:356
#, python-format
msgid "New version%s is available. Do you want to download it now?"
msgstr "La nueva versión %s está disponible. ¿Quieres descargarla ahora?"

#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:360
msgid ""
"New version{0} is available.\n"
"But it is not compatible with this version of NVDA: minimum version requred "
"= {1}, last version tested  = {2}.\n"
"Do you want to ignore this incompatibility and still download it now?"
msgstr ""
"La nueva versión {0} está disponible.\n"
"Pero no es compatible con esta versión de NVDA: versión mínima requerida = "
"{1}, última versión probada = {2}.\n"
"¿Quieres ignorar esta incompatibilidad y aún así descargarlo ahora?"

#. Translators: message to user that add-on is up to date
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:381
#, python-format
msgid "You are up-to-date. %s is the latest version."
msgstr "Estás al día, %s es la versión más reciente."

#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:388
msgid "Oops! There was a problem checking for updates. Please retry later"
msgstr ""
"¡Huy! Hubo un problema al buscar las actualizaciones. Por favor, inténtelo "
"de nuevo más tarde"

#. Translators: This is a label of a button appearing
#. on UpdateCheckResult dialog.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:543
msgid "&Yes"
msgstr "&Sí"

#. Translators: This is a label of a button appearing
#. on UpdateCheckResult dialog.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:548
msgid "&No"
msgstr "&No"

#. Translators: The label of a button to remind the user later
#. about performing some action.
#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:553
msgid "&Later"
msgstr "&Más tarde"

#: globalPlugins\apprentiClavierAccessEnhancement\updateHandler\update_check.py:557
msgid "Wha&t's new"
msgstr "Qué hay &de nuevo"
